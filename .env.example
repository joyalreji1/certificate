# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Security & Secrets
SESSION_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_aes_256_gcm

# Seed Admin User (Read only during seed script)
ADMIN_LOGIN_NAME=admin@example.com
ADMIN_INITIAL_PASSWORD=ReplaceWithStrongPassword123!

# Google Cloud OAuth 2.0 (for Google Drive integration)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
